{
    "version": "1.0.0",
    "name": "machine-facturas",
    "description": "Sistema de facturaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o e gestÃƒÆ’Ã‚Â£o empresarial para Angola",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "start": "next start",
        "build": "prisma generate && next build",
        "dev": "next dev --webpack -p 3002",
        "test": "vitest run",
        "lint": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.mjs src",
        "lint:wms": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.mjs \"src/app/(dashboard)/stock\" \"src/app/api/stock\" src/lib/stock-service.ts src/lib/invoice-service.ts src/components/warehouses tests/e2e e2e",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:e2e:local": "node scripts/e2e-local.cjs",
        "test:e2e:local:fast": "node scripts/e2e-local.cjs --skip-build",
        "db:align-prod": "node scripts/align-prod-migrations.cjs",
        "db:seed-wms": "node scripts/seed-wms-application.cjs",
        "db:seed-plans": "node scripts/seed-subscription-plans.cjs",
        "test:e2e:seed": "node --env-file=.env.e2e.local tests/e2e/wms/seed.mjs",
        "test:e2e:ui": "playwright test",
        "desktop:dev": "npm run desktop:build && electron .",
        "desktop:build": "node scripts/generate-desktop-icon.cjs && node scripts/build-desktop.cjs",
        "desktop:smoke": "node scripts/desktop-startup-smoke.cjs",
        "desktop:test": "vitest run electron desktop/offline scripts/desktop-build-config.test.ts src/lib/offline-grant-core.test.ts src/lib/desktop-sync-core.test.ts src/lib/desktop-download-url.test.ts",
        "desktop:recovery-test": "npm run desktop:build && electron dist-electron/recovery-test-main.cjs",
        "desktop:dist": "node scripts/generate-desktop-icon.cjs && npm run desktop:build && electron-builder --config electron-builder.config.cjs --win nsis",
        "admin:bootstrap": "node scripts/bootstrap-platform-admin.cjs",
        "test:wms-stress:plan": "node scripts/wms-stress-harness.cjs --url %STRESS_DATABASE_URL% --levels 20,50,100,200 --dry-run",
        "test:wms-stress": "node scripts/wms-stress-harness.cjs --url %STRESS_DATABASE_URL% --levels 20,50,100,200 --confirm-stress"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@prisma/client": "^5.22.0",
        "@supabase/server": "1.9.2",
        "@supabase/ssr": "0.12.7",
        "@supabase/supabase-js": "2.118.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bcrypt": "^6.0.0",
        "autoprefixer": "^10.6.1",
        "bcrypt": "^6.0.0",
        "exceljs": "^4.4.0",
        "fast-xml-parser": "^5.11.2",
        "next": "^16.4.2",
        "next-auth": "^5.0.0-beta.32",
        "nodemailer": "^8.0.11",
        "pdfkit": "^0.20.2",
        "pg": "^8.23.1",
        "postcss": "^8.5.30",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "server-only": "^0.0.1",
        "shadcn-ui": "^0.9.5",
        "sql.js": "1.15.2",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/sql.js": "1.4.11",
        "@typescript-eslint/parser": "^8.72.1",
        "electron": "44.10.0",
        "electron-builder": "26.18.0",
        "esbuild": "0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.2",
        "prisma": "^5.22.0",
        "qrcode": "^1.5.4",
        "typescript": "7.0.2",
        "vite": "^7.3.7",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
