  documents RhDocument[]
  versions  RhDocumentTemplateVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model RhDocument {
  id              String           @id @default(uuid())
  tenantId        String
  employeeId      String?
  templateId      String?
  templateVersion Int?
  type            RhDocumentType   @default(OUTRO)
  title           String
  content         String
  status          RhDocumentStatus @default(RASCUNHO)
  hash            String?
  issuedAt        DateTime?
  issuedByUserId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee RhEmployee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  template RhDocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, employeeId])
}


// Machine Payroll — regras configuráveis, processamento e recibos.
enum RhPayrollStatus {
  RASCUNHO
  CALCULADO
  EM_REVISAO
  APROVADO
  PENDENTE_PAGAMENTO
  PAGO
  CANCELADO
}

model RhPayrollRuleSet {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  status              String    @default("DRAFT")
  config              Json
  legalStatus         String    @default("PENDENTE")
  legalDocumentUrl    String?
  legalValidatedBy    String?
  legalValidatedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   RhPayrollRun[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model RhPayrollRun {
  id              String          @id @default(uuid())
  tenantId        String
  period          String
  rulesetId       String?
  status          RhPayrollStatus @default(RASCUNHO)
  totalGross      Decimal         @default(0) @db.Decimal(14, 2)
  totalNet        Decimal         @default(0) @db.Decimal(14, 2)
  totalInss       Decimal         @default(0) @db.Decimal(14, 2)
  totalIrt        Decimal         @default(0) @db.Decimal(14, 2)
  approvedByUserId String?
  approvedAt      DateTime?
  paidAt          DateTime?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleset  RhPayrollRuleSet? @relation(fields: [rulesetId], references: [id], onDelete: SetNull)
  payslips RhPayslip[]
  paymentBatches RhPaymentBatch[]

  @@unique([tenantId, period])
  @@index([tenantId, status])
}

model RhPayslip {
  id              String   @id @default(uuid())
  tenantId        String
  runId           String
  employeeId      String
  baseSalary      Decimal  @db.Decimal(14, 2)
  allowances      Decimal  @default(0) @db.Decimal(14, 2)
  overtime        Decimal  @default(0) @db.Decimal(14, 2)
  absences        Decimal  @default(0) @db.Decimal(14, 2)
  gross           Decimal  @db.Decimal(14, 2)
  inss            Decimal  @default(0) @db.Decimal(14, 2)
  irt             Decimal  @default(0) @db.Decimal(14, 2)
  otherDeductions Decimal  @default(0) @db.Decimal(14, 2)
  net             Decimal  @db.Decimal(14, 2)
  lines           Json?
  createdAt       DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run      RhPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee RhEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([tenantId, employeeId])
}


// Machine RH — funções por empresa (RBAC fino).
enum RhMemberRole {
  ADMIN
  MANAGER
  FINANCE
}

model RhMember {
  id        String       @id @default(uuid())
  tenantId  String
  userId    String
  role      RhMemberRole @default(MANAGER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}


// Payroll Connect — lotes de pagamento (sem transferência real).
enum RhPaymentProvider {
  MANUAL
  EMIS
}

enum RhPaymentStatus {
  DRAFT
  SENT
  CONFIRMED
  FAILED
}

model RhPaymentBatch {
  id             String            @id @default(uuid())
  tenantId       String
  runId          String            @unique
  provider       RhPaymentProvider @default(MANUAL)
  status         RhPaymentStatus   @default(DRAFT)
  total          Decimal           @db.Decimal(14, 2)
  reference      String?
  error          String?
  createdAt      DateTime          @default(now())
  sentAt         DateTime?
  confirmedAt    DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    RhPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  items  RhPaymentItem[]

  @@index([tenantId, status])
}

model RhPaymentItem {
  id          String          @id @default(uuid())
  tenantId    String
  batchId     String
  employeeId  String
  amount      Decimal         @db.Decimal(14, 2)
  status      RhPaymentStatus @default(DRAFT)
  externalRef String?
  createdAt   DateTime        @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch    RhPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee RhEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([batchId, employeeId])
  @@index([tenantId, status])
}


// Machine Documents — versões imutáveis dos modelos.
model RhDocumentTemplateVersion {
  id              String         @id @default(uuid())
  tenantId        String
  templateId      String
  version         Int
  name            String
  type            RhDocumentType
  body            String
  createdByUserId String?
  createdAt       DateTime       @default(now())

  template RhDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([tenantId, templateId])
}


// Ciclo de vida — histórico salarial e desligamento.
enum RhOffboardingStatus {
  EM_PROCESSO
  CONCLUIDO
}

model RhSalaryChange {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String
  oldSalary       Decimal  @db.Decimal(14, 2)
  newSalary       Decimal  @db.Decimal(14, 2)
  effectiveDate   DateTime
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  employee RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveDate])
}

model RhOffboarding {
  id              String             @id @default(uuid())
  tenantId        String
  employeeId      String             @unique
  reason          String
  lastDay         DateTime
  status          RhOffboardingStatus @default(CONCLUIDO)
  notes           String?
  revokeAccess    Boolean            @default(false)
  decidedByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  employee RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}


// Justificações de faltas e notificações internas.
enum RhJustificationStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model RhAbsenceJustification {
  id              String                @id @default(uuid())
  tenantId        String
  employeeId      String
  date            DateTime
  type            String
  reason          String
  status          RhJustificationStatus @default(PENDENTE)
  decisionNote    String?
  decidedByUserId String?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  employee RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date, type])
  @@index([tenantId, status, date])
}

model RhNotification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
}


// Recrutamento e seleção.
enum RhJobOpeningStatus {
  ABERTA
  ENCERRADA
  CANCELADA
}

enum RhCandidateStatus {
  RECEBIDA
  TRIAGEM
  ENTREVISTA
  AVALIACAO
  APROVADO
  REJEITADO
  ADMITIDO
}

model RhJobOpening {
  id           String            @id @default(uuid())
  tenantId     String
  title        String
  departmentId String?
  positionId   String?
  openings     Int               @default(1)
  requirements String?
  closesAt     DateTime?
  status       RhJobOpeningStatus @default(ABERTA)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department RhDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   RhPosition?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  candidates RhCandidate[]

  @@index([tenantId, status])
}

model RhCandidate {
  id          String            @id @default(uuid())
  tenantId    String
  jobOpeningId String
  firstName   String
  lastName    String
  email       String
  phone       String?
  cvUrl       String?
  notes       String?
  status      RhCandidateStatus @default(RECEBIDA)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  jobOpening RhJobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  events     RhCandidateEvent[]

  @@index([tenantId, jobOpeningId, status])
  @@index([tenantId, email])
}

model RhCandidateEvent {
  id              String            @id @default(uuid())
  tenantId        String
  candidateId     String
  fromStatus      RhCandidateStatus?
  toStatus        RhCandidateStatus
  note            String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  candidate RhCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId])
}


// Avaliação de desempenho.
enum RhReviewCycleStatus {
  ABERTO
  FECHADO
}

enum RhReviewStatus {
  PENDENTE
  ENTREGUE
  VALIDADO
}

model RhPerformanceCycle {
  id        String             @id @default(uuid())
  tenantId  String
  name      String
  startsAt  DateTime
  endsAt    DateTime?
  status    RhReviewCycleStatus @default(ABERTO)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criteria RhPerfCriterion[]
  reviews  RhPerformanceReview[]
  selfAssessments RhPerformanceReviewSelfAssessment[]

  @@index([tenantId, status])
}

model RhPerfCriterion {
  id       String @id @default(uuid())
  tenantId String
  cycleId  String
  name     String
  weight   Int    @default(1)
  order    Int    @default(0)

  cycle RhPerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([tenantId, cycleId, order])
}

model RhPerformanceReview {
  id           String         @id @default(uuid())
  tenantId     String
  cycleId      String
  employeeId   String
  reviewerName String?
  score        Int?
  comments     String?
  status       RhReviewStatus @default(PENDENTE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  cycle    RhPerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee RhEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId])
  @@index([tenantId, cycleId, status])
}


// Formação profissional.
enum RhTrainingStatus {
  AGENDADO
  EM_CURSO
  CONCLUIDO
  CANCELADO
}

enum RhEnrollmentStatus {
  INSCRITO
  CONCLUIDA
  DESISTENTE
}

model RhTrainingCourse {
  id                 String           @id @default(uuid())
  tenantId           String
  title              String
  trainerName        String?
  startDate          DateTime
  endDate            DateTime?
  cargaHoras         Int              @default(8)
  location           String?
  requiredForPositionId String?
  status             RhTrainingStatus @default(AGENDADO)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments RhTrainingEnrollment[]

  @@index([tenantId, status, startDate])
}

model RhTrainingEnrollment {
  id            String             @id @default(uuid())
  tenantId      String
  courseId      String
  employeeId    String
  status        RhEnrollmentStatus @default(INSCRITO)
  score         Int?
  certificateUrl String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  course   RhTrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee RhEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([tenantId, courseId, status])
}


// Descontos recorrentes do funcionário (adiantamentos, empréstimos).
enum RhDeductionType {
  ADIANTAMENTO
  EMPRESTIMO
  OUTRO
}

model RhEmployeeDeduction {
  id                     String           @id @default(uuid())
  tenantId               String
  employeeId             String
  description            String
  type                   RhDeductionType  @default(OUTRO)
  amount                 Decimal          @db.Decimal(14, 2)
  remainingInstallments  Int?
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  employee RhEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, active])
}


// Comunicados internos.
model RhAnnouncement {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  body        String
  priority    String    @default("NORMAL")
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdByUserId String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
}


// Autoavaliação do funcionário (self-assessment).
model RhPerformanceReviewSelfAssessment {
  id          String   @id @default(uuid())
  tenantId    String
  cycleId     String
  employeeId  String
  selfScore   Int?
  comments    String?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle    RhPerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee RhEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId])
  @@index([tenantId, cycleId])
}
