generator client {

  provider   = "prisma-client-js"

  engineType = "library"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



model Tenant {

  id                       String                    @id @default(uuid())

  name                     String

  nif                      String?

  address                  String?

  phone                    String?

  email                    String?

  createdAt                DateTime                  @default(now())

  website                  String?

  bankName                 String?

  bankAccountName          String?

  iban                     String?

  currentLogoId            String?                   @unique

  legalName                String?

  municipality             String?

  province                 String?

  country                  String?

  brandColor               String?

  invoiceFooter            String?

  defaultMessage           String?

  defaultCurrency          String                    @default("AOA")

  documentLanguage         String                    @default("pt-AO")

  defaultPaymentDays       Int?

  defaultPaymentMethod     String?

  defaultObservations      String?

  status                   AccountStatus             @default(ACTIVE)

  suspendedAt              DateTime?

  suspensionReason         String?

  plan                     String                    @default("FREE")

  planExpiry               DateTime?

  adUnlocks                AdUnlock[]

  businessDocuments        BusinessDocument[]

  businessDocumentCounters BusinessDocumentCounter[]

  businessDocumentEvents   BusinessDocumentEvent[]

  bankAccounts             CompanyBankAccount[]

  logos                    CompanyLogo[]             @relation("TenantLogoVersions")

  customers                Customer[]

  emailDeliveries          EmailDelivery[]

  invoices                 Invoice[]

  invoiceDrafts            InvoiceDraft[]

  payments                 Payment[]

  paymentEvents            PaymentEvent[]

  planPayments             PlanPayment[]

  products                 Product[]

  productWarehouseStocks   ProductWarehouseStock[]

  purchaseOrders           PurchaseOrder[]

  purchaseReceptions       PurchaseReception[]

  stockAdjustments         StockAdjustment[]

  stockLots                StockLot[]

  stockMovements           StockMovement[]

  stockReservations        StockReservation[]

  stockTransfers           StockTransfer[]

  stockTransferReceptions  StockTransferReception[]

  suppliers                Supplier[]

  currentLogo              CompanyLogo?              @relation("CurrentTenantLogo", fields: [currentLogoId], references: [id])

  tenantApplications       TenantApplication[]

  tenantSubscriptions      TenantSubscription[]

  users                    User[]

  warehouses               Warehouse[]

  rhDepartments            RhDepartment[]

  rhPositions              RhPosition[]

  rhEmployees              RhEmployee[]

  rhContracts              RhContract[]

  rhTimeEntries            RhTimeEntry[]
  rhJobOpenings            RhJobOpening[]
  rhPerformanceCycles      RhPerformanceCycle[]
  rhTrainingCourses        RhTrainingCourse[]
  rhAnnouncements          RhAnnouncement[]
  rhDevices                RhDevice[]
  rhDocumentTemplates      RhDocumentTemplate[]
  rhDocuments              RhDocument[]
  rhPayrollRuleSets        RhPayrollRuleSet[]
  rhPayrollRuns            RhPayrollRun[]
  rhPayslips               RhPayslip[]
  rhMembers                RhMember[]
  rhPaymentBatches         RhPaymentBatch[]
  rhPaymentItems           RhPaymentItem[]
  rhShifts                 RhShift[]
  rhLeaveRequests          RhLeaveRequest[]
  rhSettings               RhSettings?

  rhAuditLogs              RhAuditLog[]

}



model PlanPayment {

  id         String    @id @default(uuid())

  tenantId   String

  payerName  String

  payerPhone String

  amountKz   Decimal   @db.Decimal(12, 2)

  months     Int       @default(1)

  planSlug   String?

  billingCycle String?

  proofName  String?

  proofData  String?

  status     String    @default("PENDENTE")

  adminNote  String?

  createdAt  DateTime  @default(now())

  reviewedAt DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id])



  @@index([status, createdAt])

  @@index([tenantId])

}



model PaymentReceipt {

  id             String   @id @default(uuid())

  paymentId      String   @unique

  tenantId       String

  number         String

  shareToken     String   @unique

  shareExpiresAt DateTime

  createdAt      DateTime @default(now())

  payment        Payment  @relation(fields: [paymentId], references: [id])



  @@index([tenantId])

}



model Customer {

  id                String             @id @default(uuid())

  tenantId          String

  name              String

  nif               String?

  address           String?

  email             String?

  createdAt         DateTime           @default(now())

  businessDocuments BusinessDocument[]

  tenant            Tenant             @relation(fields: [tenantId], references: [id])

  invoices          Invoice[]

}



model Product {

  id                          String                       @id @default(uuid())

  tenantId                    String

  name                        String

  description                 String?

  price                       Decimal                      @db.Decimal(12, 2)

  taxRate                     Decimal                      @default(14.00) @db.Decimal(5, 2)

  codigo                      String?

  stock                       Decimal                      @default(0) @db.Decimal(12, 3)

  trackStock                  Boolean                      @default(false)

  categoria                   String                       @default("GERAL")

  subcategoria                String?

  marca                       String?

  modelo                      String?

  unidade                     String                       @default("un")

  purchasePrice               Decimal?                     @db.Decimal(12, 2)

  imageUrl                    String?

  createdAt                   DateTime                     @default(now())

  minStock                    Decimal                      @default(0) @db.Decimal(12, 3)

  barcode                     String?

  businessDocumentItems       BusinessDocumentItem[]

  items                       InvoiceItem[]

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])

  warehouseStocks             ProductWarehouseStock[]

  purchaseItems               PurchaseOrderItem[]

  purchaseReceptionItems      PurchaseReceptionItem[]

  adjustmentItems             StockAdjustmentItem[]

  lots                        StockLot[]

  stockMovements              StockMovement[]

  reservations                StockReservation[]

  stockTransferItems          StockTransferItem[]          @relation("TransferProduct")

  stockTransferReceptionItems StockTransferReceptionItem[] @relation("TransferReceptionProduct")



  @@unique([tenantId, barcode])

  @@unique([tenantId, id], map: "Product_tenant_id_unique")

  @@index([tenantId])

  @@index([codigo])

}



model Warehouse {

  id                     String                   @id @default(uuid())

  tenantId               String

  name                   String

  location               String?

  isDefault              Boolean                  @default(false)

  isActive               Boolean                  @default(true)

  createdAt              DateTime                 @default(now())

  updatedAt              DateTime                 @updatedAt

  productStocks          ProductWarehouseStock[]

  purchaseReceptions     PurchaseReception[]

  adjustments            StockAdjustment[]

  movements              StockMovement[]          @relation("MovementWarehouse")

  reservations           StockReservation[]

  fromTransfers          StockTransfer[]          @relation("TransferFrom")

  toTransfers            StockTransfer[]          @relation("TransferTo")

  transferReceptionsFrom StockTransferReception[] @relation("TransferReceptionFrom")

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])



  @@unique([tenantId, id])

  @@index([tenantId])

}



model ProductWarehouseStock {

  id               String                @id @default(uuid())

  tenantId         String

  productId        String

  warehouseId      String

  lotId            String?

  quantity         Decimal               @default(0) @db.Decimal(12, 3)

  reservedQuantity Decimal               @default(0) @db.Decimal(12, 3)

  minStock         Decimal               @default(0) @db.Decimal(12, 3)

  location         String?

  isLegacy         Boolean               @default(false)

  createdAt        DateTime              @default(now())

  updatedAt        DateTime              @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id])

  lot              StockLot?             @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)

  product          Product               @relation(fields: [tenantId, productId], references: [tenantId, id])

  warehouse        Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  adjustmentItems  StockAdjustmentItem[]

  reservations     StockReservation[]



  @@unique([tenantId, id])

  @@index([tenantId, warehouseId])

  @@index([tenantId, productId])

  @@index([warehouseId])

  @@index([lotId])

}



model StockLot {

  id                          String                       @id @default(uuid())

  tenantId                    String

  productId                   String

  lotNumber                   String

  expiryDate                  DateTime?

  receivedAt                  DateTime                     @default(now())

  stockItems                  ProductWarehouseStock[]

  purchaseReceptionItems      PurchaseReceptionItem[]

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])

  product                     Product                      @relation(fields: [tenantId, productId], references: [tenantId, id])

  stockTransferItems          StockTransferItem[]          @relation("StockTransferItemLot")

  stockTransferReceptionItems StockTransferReceptionItem[] @relation("StockTransferReceptionItemLot")



  @@unique([tenantId, id])

  @@unique([tenantId, productId, lotNumber])

  @@index([tenantId, productId])

  @@index([tenantId, expiryDate])

}



model Supplier {

  id             String          @id @default(uuid())

  tenantId       String

  name           String

  nif            String?

  contact        String?

  address        String?

  email          String?

  isActive       Boolean         @default(true)

  createdAt      DateTime        @default(now())

  updatedAt      DateTime        @updatedAt

  purchaseOrders PurchaseOrder[]

  tenant         Tenant          @relation(fields: [tenantId], references: [id])



  @@unique([tenantId, id])

  @@unique([tenantId, nif])

  @@index([tenantId])

  @@index([nif])

}



model PurchaseOrder {

  id              String              @id @default(uuid())

  tenantId        String

  supplierId      String

  status          String              @default("PENDENTE")

  total           Decimal             @db.Decimal(12, 2)

  expectedAt      DateTime?

  receivedAt      DateTime?

  createdByUserId String?

  createdAt       DateTime            @default(now())

  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])

  supplier        Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])

  items           PurchaseOrderItem[]

  receptions      PurchaseReception[]



  @@unique([tenantId, id])

  @@index([tenantId])

  @@index([supplierId])

  @@index([status])

}



model PurchaseOrderItem {

  id              String                  @id @default(uuid())

  purchaseOrderId String

  productId       String

  quantity        Decimal                 @db.Decimal(12, 3)

  receivedQty     Decimal                 @default(0) @db.Decimal(12, 3)

  unitPrice       Decimal                 @db.Decimal(12, 2)

  tenantId        String

  product         Product                 @relation(fields: [tenantId, productId], references: [tenantId, id])

  purchaseOrder   PurchaseOrder           @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)

  receptionItems  PurchaseReceptionItem[] @relation("PurchaseOrderItemReceptions")



  @@unique([tenantId, id])

  @@index([purchaseOrderId])

  @@index([productId])

}



model PurchaseReception {

  id              String                  @id @default(uuid())

  tenantId        String

  purchaseOrderId String

  warehouseId     String

  receivedAt      DateTime                @default(now())

  createdByUserId String?

  reference       String?

  notes           String?

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])

  purchaseOrder   PurchaseOrder           @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id])

  warehouse       Warehouse               @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  items           PurchaseReceptionItem[]

  movements       StockMovement[]



  @@unique([tenantId, id])

  @@index([tenantId])

  @@index([purchaseOrderId])

  @@index([warehouseId])

}



model PurchaseReceptionItem {

  id                  String            @id @default(uuid())

  receptionId         String

  purchaseOrderItemId String

  productId           String

  lotId               String?

  quantity            Decimal           @db.Decimal(12, 3)

  unitCost            Decimal?          @db.Decimal(12, 2)

  tenantId            String

  lot                 StockLot?         @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)

  product             Product           @relation(fields: [tenantId, productId], references: [tenantId, id])

  purchaseOrderItem   PurchaseOrderItem @relation("PurchaseOrderItemReceptions", fields: [tenantId, purchaseOrderItemId], references: [tenantId, id], onDelete: Cascade)

  reception           PurchaseReception @relation(fields: [tenantId, receptionId], references: [tenantId, id], onDelete: Cascade)



  @@index([receptionId])

  @@index([purchaseOrderItemId])

}



model StockTransfer {

  id              String                   @id @default(uuid())

  tenantId        String

  fromWarehouseId String

  toWarehouseId   String

  status          StockTransferStatus      @default(PENDING)

  reference       String?

  createdByUserId String?

  createdAt       DateTime                 @default(now())

  receivedAt      DateTime?

  movements       StockMovement[]

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])

  fromWarehouse   Warehouse                @relation("TransferFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id])

  toWarehouse     Warehouse                @relation("TransferTo", fields: [tenantId, toWarehouseId], references: [tenantId, id])

  items           StockTransferItem[]

  receptions      StockTransferReception[]



  @@unique([tenantId, id])

  @@unique([tenantId, fromWarehouseId, toWarehouseId, reference])

  @@index([tenantId])

  @@index([fromWarehouseId])

  @@index([toWarehouseId])

  @@index([status])

  @@index([reference])

}



model StockTransferItem {

  id             String                       @id @default(uuid())

  transferId     String

  productId      String

  lotId          String?

  quantity       Decimal                      @db.Decimal(12, 3)

  receivedQty    Decimal                      @default(0) @db.Decimal(12, 3)

  rejectedQty    Decimal                      @default(0) @db.Decimal(12, 3)

  tenantId       String

  lot            StockLot?                    @relation("StockTransferItemLot", fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)

  product        Product                      @relation("TransferProduct", fields: [tenantId, productId], references: [tenantId, id])

  transfer       StockTransfer                @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)

  receptionItems StockTransferReceptionItem[]



  @@unique([tenantId, id])

  @@index([transferId])

  @@index([productId])

  @@index([lotId])

}



model StockTransferReception {

  id              String                       @id @default(uuid())

  tenantId        String

  transferId      String

  warehouseId     String

  receivedAt      DateTime                     @default(now())

  createdByUserId String?

  reference       String?

  notes           String?

  movement        StockMovement?               @relation("TransferReceptionMovement")

  tenant          Tenant                       @relation(fields: [tenantId], references: [id])

  transfer        StockTransfer                @relation(fields: [tenantId, transferId], references: [tenantId, id])

  warehouse       Warehouse                    @relation("TransferReceptionFrom", fields: [tenantId, warehouseId], references: [tenantId, id])

  items           StockTransferReceptionItem[]



  @@unique([tenantId, id])

  @@index([tenantId])

  @@index([transferId])

  @@index([warehouseId])

}



model StockTransferReceptionItem {

  id             String                 @id @default(uuid())

  receptionId    String

  transferItemId String

  productId      String

  lotId          String?

  quantity       Decimal                @db.Decimal(12, 3)

  rejectedQty    Decimal                @default(0) @db.Decimal(12, 3)

  tenantId       String

  lot            StockLot?              @relation("StockTransferReceptionItemLot", fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)

  product        Product                @relation("TransferReceptionProduct", fields: [tenantId, productId], references: [tenantId, id])

  reception      StockTransferReception @relation(fields: [tenantId, receptionId], references: [tenantId, id], onDelete: Cascade)

  transferItem   StockTransferItem      @relation(fields: [tenantId, transferItemId], references: [tenantId, id], onDelete: Cascade)



  @@index([receptionId])

  @@index([transferItemId])

}



model StockAdjustment {

  id              String                @id @default(uuid())

  tenantId        String

  warehouseId     String

  reason          String

  reference       String?

  status          AdjustmentStatus      @default(OPEN)

  createdByUserId String?

  closedByUserId  String?

  createdAt       DateTime              @default(now())

  closedAt        DateTime?

  tenant          Tenant                @relation(fields: [tenantId], references: [id])

  warehouse       Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  items           StockAdjustmentItem[]



  @@unique([tenantId, id])

  @@index([tenantId])

  @@index([warehouseId])

  @@index([status])

}



model StockAdjustmentItem {

  id           String                @id @default(uuid())

  adjustmentId String

  productId    String

  stockId      String

  systemQty    Decimal               @db.Decimal(12, 3)

  countedQty   Decimal               @db.Decimal(12, 3)

  difference   Decimal               @db.Decimal(12, 3)

  tenantId     String

  adjustment   StockAdjustment       @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)

  product      Product               @relation(fields: [tenantId, productId], references: [tenantId, id])

  stock        ProductWarehouseStock @relation(fields: [tenantId, stockId], references: [tenantId, id])



  @@index([adjustmentId])

}



model StockReservation {

  id             String                @id @default(uuid())

  tenantId       String

  productId      String

  warehouseId    String

  stockId        String

  quantity       Decimal               @db.Decimal(12, 3)

  orderReference String?

  orderType      String?

  status         ReservationStatus     @default(ACTIVE)

  expiresAt      DateTime?

  releasedAt     DateTime?

  tenant         Tenant                @relation(fields: [tenantId], references: [id])

  product        Product               @relation(fields: [tenantId, productId], references: [tenantId, id])

  stock          ProductWarehouseStock @relation(fields: [tenantId, stockId], references: [tenantId, id])

  warehouse      Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])



  @@index([tenantId])

  @@index([warehouseId])

  @@index([orderReference])

  @@index([expiresAt])

  @@index([status])

}



model StockMovement {

  id                  String                  @id @default(uuid())

  tenantId            String

  productId           String

  type                StockMovementType

  quantity            Decimal                 @db.Decimal(12, 3)

  reason              String?

  reference           String?

  createdByUserId     String?

  createdAt           DateTime                @default(now())

  idempotencyKey      String?

  purchaseReceptionId String?

  quantitySigned      Decimal?                @db.Decimal(12, 3)

  reversalOfId        String?                 @unique

  transferId          String?

  transferReceptionId String?

  warehouseId         String?

  reversalOf          StockMovement?          @relation("MovementReversal", fields: [tenantId, reversalOfId], references: [tenantId, id], onDelete: SetNull, map: "StockMovement_reversalOfId_fkey")

  reversal            StockMovement?          @relation("MovementReversal")

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])

  product             Product                 @relation(fields: [tenantId, productId], references: [tenantId, id])

  purchaseReception   PurchaseReception?      @relation(fields: [tenantId, purchaseReceptionId], references: [tenantId, id], onDelete: SetNull)

  transfer            StockTransfer?          @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: SetNull)

  transferReception   StockTransferReception? @relation("TransferReceptionMovement", fields: [tenantId, transferReceptionId], references: [tenantId, id], onDelete: SetNull)

  warehouse           Warehouse?              @relation("MovementWarehouse", fields: [tenantId, warehouseId], references: [tenantId, id])



  @@unique([tenantId, id])

  @@unique([tenantId, idempotencyKey])

  @@unique([tenantId, transferReceptionId])

  @@unique([tenantId, reversalOfId])

  @@index([tenantId])

  @@index([productId])

  @@index([warehouseId])

  @@index([transferId])

  @@index([purchaseReceptionId])

  @@index([transferReceptionId])

  @@index([reversalOfId])

  @@index([createdAt])

}



model AdUnlock {

  id                  String    @id @default(uuid())

  tenantId            String    @map("tenant_id")

  status              String    @default("PENDING")

  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)

  grantedAt           DateTime? @map("granted_at") @db.Timestamptz(3)

  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)

  consumedByInvoiceId String?   @map("consumed_by_invoice_id")

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  @@index([tenantId, status], map: "ad_unlock_tenant_status_idx")

}



model Invoice {

  id                     String          @id @default(uuid())

  tenantId               String

  customerId             String

  number                 String

  type                   String          @default("FT")

  status                 String          @default("ISSUED")

  total                  Decimal         @db.Decimal(12, 2)

  subTotal               Decimal         @db.Decimal(12, 2)

  taxTotal               Decimal         @db.Decimal(12, 2)

  hash                   String?

  previousHash           String?

  signature              String?

  refInvoiceNumber       String?

  cancelReason           String?

  issuedAt               DateTime        @default(now())

  createdAt              DateTime        @default(now())

  discountAmount         Decimal         @default(0) @db.Decimal(12, 2)

  discountType           String          @default("amount")

  discountValue          Decimal         @default(0) @db.Decimal(12, 2)

  applyVat               Boolean         @default(true)

  observations           String?

  includeCompanyProfile  Boolean         @default(false)

  companyProfileSnapshot Json?

  companyLogoId          String?

  dueAt                  DateTime?

  currency               String          @default("AOA")

  sourceDraftId          String?         @unique

  shareExpiresAt         DateTime?

  shareToken             String?         @unique

  lastReminderAt         DateTime?

  emailDeliveries        EmailDelivery[]

  companyLogo            CompanyLogo?    @relation("InvoiceCompanyLogo", fields: [companyLogoId], references: [id], onDelete: Restrict)

  customer               Customer        @relation(fields: [customerId], references: [id])

  sourceDraft            InvoiceDraft?   @relation("DraftConversion", fields: [sourceDraftId], references: [id])

  tenant                 Tenant          @relation(fields: [tenantId], references: [id])

  items                  InvoiceItem[]

  payments               Payment[]

}



model CompanyBankAccount {

  id            String         @id @default(uuid())

  tenantId      String

  bankName      String

  accountHolder String?

  iban          String?

  currency      String         @default("AOA")

  label         String?

  isActive      Boolean        @default(true)

  isPrimary     Boolean        @default(false)

  createdAt     DateTime       @default(now())

  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceDrafts InvoiceDraft[]



  @@index([tenantId, isActive])

}



model Payment {

  id              String          @id @default(uuid())

  tenantId        String

  invoiceId       String

  amount          Decimal         @db.Decimal(12, 2)

  currency        String          @default("AOA")

  method          String

  status          String          @default("PENDING")

  paymentDate     DateTime

  reference       String?

  notes           String?

  idempotencyKey  String

  createdByUserId String?

  createdAt       DateTime        @default(now())

  updatedAt       DateTime        @updatedAt

  createdBy       User?           @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])

  invoice         Invoice         @relation(fields: [invoiceId], references: [id])

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  events          PaymentEvent[]

  receipt         PaymentReceipt?



  @@unique([tenantId, idempotencyKey])

  @@unique([invoiceId, method, reference])

  @@index([tenantId, paymentDate])

  @@index([tenantId, status])

  @@index([invoiceId, status])

}



model InvoiceDraft {

  id                       String              @id @default(uuid())

  tenantId                 String

  customerName             String              @default("")

  customerNif              String?

  items                    Json                @default("[]")

  applyVat                 Boolean             @default(true)

  discountType             String              @default("amount")

  discountValue            Decimal             @default(0) @db.Decimal(12, 2)

  observations             String?

  includeCompanyProfile    Boolean             @default(true)

  currency                 String              @default("AOA")

  dueAt                    DateTime?

  companyBankAccountId     String?

  createdAt                DateTime            @default(now())

  updatedAt                DateTime            @updatedAt

  status                   String              @default("DRAFT")

  sourceBusinessDocumentId String?             @unique

  issuedInvoice            Invoice?            @relation("DraftConversion")

  companyBankAccount       CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])

  sourceBusinessDocument   BusinessDocument?   @relation("BusinessDocumentInvoiceDraft", fields: [sourceBusinessDocumentId], references: [id])

  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  @@index([tenantId, updatedAt])

}



model BusinessDocumentCounter {

  tenantId   String

  type       BusinessDocumentType

  year       Int

  lastNumber Int                  @default(0)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)



  @@id([tenantId, type, year])

  @@index([tenantId])

}



model BusinessDocument {

  id                    String                  @id @default(uuid())

  tenantId              String

  type                  BusinessDocumentType

  status                BusinessDocumentStatus  @default(DRAFT)

  number                String

  title                 String

  customerId            String?

  createdByUserId       String?

  issueDate             DateTime                @db.Date

  validUntil            DateTime?               @db.Date

  currency              String                  @default("AOA")

  details               String?

  notes                 String?

