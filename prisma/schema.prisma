generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  nif                      String?
  address                  String?
  phone                    String?
  email                    String?
  createdAt                DateTime                  @default(now())
  website                  String?
  bankName                 String?
  bankAccountName          String?
  iban                     String?
  currentLogoId            String?                   @unique
  legalName                String?
  municipality             String?
  province                 String?
  country                  String?
  brandColor               String?
  invoiceFooter            String?
  defaultMessage           String?
  defaultCurrency          String                    @default("AOA")
  documentLanguage         String                    @default("pt-AO")
  defaultPaymentDays       Int?
  defaultPaymentMethod     String?
  defaultObservations      String?
  status                   AccountStatus             @default(ACTIVE)
  suspendedAt              DateTime?
  suspensionReason         String?
  plan                     String                    @default("FREE")
  planExpiry               DateTime?
  adUnlocks                AdUnlock[]
  businessDocuments        BusinessDocument[]
  businessDocumentCounters BusinessDocumentCounter[]
  businessDocumentEvents   BusinessDocumentEvent[]
  bankAccounts             CompanyBankAccount[]
  logos                    CompanyLogo[]             @relation("TenantLogoVersions")
  customers                Customer[]
  emailDeliveries          EmailDelivery[]
  invoices                 Invoice[]
  invoiceDrafts            InvoiceDraft[]
  payments                 Payment[]
  paymentEvents            PaymentEvent[]
  planPayments             PlanPayment[]
  products                 Product[]
  productWarehouseStocks   ProductWarehouseStock[]
  purchaseOrders           PurchaseOrder[]
  purchaseReceptions       PurchaseReception[]
  stockAdjustments         StockAdjustment[]
  stockLots                StockLot[]
  stockMovements           StockMovement[]
  stockReservations        StockReservation[]
  stockTransfers           StockTransfer[]
  stockTransferReceptions  StockTransferReception[]
  suppliers                Supplier[]
  currentLogo              CompanyLogo?              @relation("CurrentTenantLogo", fields: [currentLogoId], references: [id])
  tenantApplications       TenantApplication[]
  tenantSubscriptions      TenantSubscription[]
  users                    User[]
  warehouses               Warehouse[]
}

model PlanPayment {
  id         String    @id @default(uuid())
  tenantId   String
  payerName  String
  payerPhone String
  amountKz   Decimal   @db.Decimal(12, 2)
  months     Int       @default(1)
  proofName  String?
  proofData  String?
  status     String    @default("PENDENTE")
  adminNote  String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@index([tenantId])
}

model PaymentReceipt {
  id             String   @id @default(uuid())
  paymentId      String   @unique
  tenantId       String
  number         String
  shareToken     String   @unique
  shareExpiresAt DateTime
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
}

model Customer {
  id                String             @id @default(uuid())
  tenantId          String
  name              String
  nif               String?
  address           String?
  email             String?
  createdAt         DateTime           @default(now())
  businessDocuments BusinessDocument[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  invoices          Invoice[]
}

model Product {
  id                          String                       @id @default(uuid())
  tenantId                    String
  name                        String
  description                 String?
  price                       Decimal                      @db.Decimal(12, 2)
  taxRate                     Decimal                      @default(14.00) @db.Decimal(5, 2)
  codigo                      String?
  stock                       Decimal                      @default(0) @db.Decimal(12, 3)
  trackStock                  Boolean                      @default(false)
  categoria                   String                       @default("GERAL")
  createdAt                   DateTime                     @default(now())
  minStock                    Decimal                      @default(0) @db.Decimal(12, 3)
  barcode                     String?
  businessDocumentItems       BusinessDocumentItem[]
  items                       InvoiceItem[]
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  warehouseStocks             ProductWarehouseStock[]
  purchaseItems               PurchaseOrderItem[]
  purchaseReceptionItems      PurchaseReceptionItem[]
  adjustmentItems             StockAdjustmentItem[]
  lots                        StockLot[]
  stockMovements              StockMovement[]
  reservations                StockReservation[]
  stockTransferItems          StockTransferItem[]          @relation("TransferProduct")
  stockTransferReceptionItems StockTransferReceptionItem[] @relation("TransferReceptionProduct")

  @@unique([tenantId, barcode])
  @@unique([tenantId, id], map: "Product_tenant_id_unique")
  @@index([tenantId])
  @@index([codigo])
}

model Warehouse {
  id                     String                   @id @default(uuid())
  tenantId               String
  name                   String
  location               String?
  isDefault              Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  productStocks          ProductWarehouseStock[]
  purchaseReceptions     PurchaseReception[]
  adjustments            StockAdjustment[]
  movements              StockMovement[]          @relation("MovementWarehouse")
  reservations           StockReservation[]
  fromTransfers          StockTransfer[]          @relation("TransferFrom")
  toTransfers            StockTransfer[]          @relation("TransferTo")
  transferReceptionsFrom StockTransferReception[] @relation("TransferReceptionFrom")
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId])
}

model ProductWarehouseStock {
  id               String                @id @default(uuid())
  tenantId         String
  productId        String
  warehouseId      String
  lotId            String?
  quantity         Decimal               @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal               @default(0) @db.Decimal(12, 3)
  minStock         Decimal               @default(0) @db.Decimal(12, 3)
  location         String?
  isLegacy         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  lot              StockLot?             @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)
  product          Product               @relation(fields: [tenantId, productId], references: [tenantId, id])
  warehouse        Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  adjustmentItems  StockAdjustmentItem[]
  reservations     StockReservation[]

  @@unique([tenantId, id])
  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
  @@index([warehouseId])
  @@index([lotId])
}

model StockLot {
  id                          String                       @id @default(uuid())
  tenantId                    String
  productId                   String
  lotNumber                   String
  expiryDate                  DateTime?
  receivedAt                  DateTime                     @default(now())
  stockItems                  ProductWarehouseStock[]
  purchaseReceptionItems      PurchaseReceptionItem[]
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  product                     Product                      @relation(fields: [tenantId, productId], references: [tenantId, id])
  stockTransferItems          StockTransferItem[]          @relation("StockTransferItemLot")
  stockTransferReceptionItems StockTransferReceptionItem[] @relation("StockTransferReceptionItemLot")

  @@unique([tenantId, id])
  @@unique([tenantId, productId, lotNumber])
  @@index([tenantId, productId])
  @@index([tenantId, expiryDate])
}

model Supplier {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  nif            String?
  contact        String?
  address        String?
  email          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, nif])
  @@index([tenantId])
  @@index([nif])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  tenantId        String
  supplierId      String
  status          String              @default("PENDENTE")
  total           Decimal             @db.Decimal(12, 2)
  expectedAt      DateTime?
  receivedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  supplier        Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  items           PurchaseOrderItem[]
  receptions      PurchaseReception[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String                  @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal                 @db.Decimal(12, 3)
  receivedQty     Decimal                 @default(0) @db.Decimal(12, 3)
  unitPrice       Decimal                 @db.Decimal(12, 2)
  tenantId        String
  product         Product                 @relation(fields: [tenantId, productId], references: [tenantId, id])
  purchaseOrder   PurchaseOrder           @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  receptionItems  PurchaseReceptionItem[] @relation("PurchaseOrderItemReceptions")

  @@unique([tenantId, id])
  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseReception {
  id              String                  @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  warehouseId     String
  receivedAt      DateTime                @default(now())
  createdByUserId String?
  reference       String?
  notes           String?
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  purchaseOrder   PurchaseOrder           @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id])
  warehouse       Warehouse               @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items           PurchaseReceptionItem[]
  movements       StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model PurchaseReceptionItem {
  id                  String            @id @default(uuid())
  receptionId         String
  purchaseOrderItemId String
  productId           String
  lotId               String?
  quantity            Decimal           @db.Decimal(12, 3)
  unitCost            Decimal?          @db.Decimal(12, 2)
  tenantId            String
  lot                 StockLot?         @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)
  product             Product           @relation(fields: [tenantId, productId], references: [tenantId, id])
  purchaseOrderItem   PurchaseOrderItem @relation("PurchaseOrderItemReceptions", fields: [tenantId, purchaseOrderItemId], references: [tenantId, id], onDelete: Cascade)
  reception           PurchaseReception @relation(fields: [tenantId, receptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([receptionId])
  @@index([purchaseOrderItemId])
}

model StockTransfer {
  id              String                   @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus      @default(PENDING)
  reference       String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  receivedAt      DateTime?
  movements       StockMovement[]
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  fromWarehouse   Warehouse                @relation("TransferFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id])
  toWarehouse     Warehouse                @relation("TransferTo", fields: [tenantId, toWarehouseId], references: [tenantId, id])
  items           StockTransferItem[]
  receptions      StockTransferReception[]

  @@unique([tenantId, id])
  @@unique([tenantId, fromWarehouseId, toWarehouseId, reference])
  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([reference])
}

model StockTransferItem {
  id             String                       @id @default(uuid())
  transferId     String
  productId      String
  lotId          String?
  quantity       Decimal                      @db.Decimal(12, 3)
  receivedQty    Decimal                      @default(0) @db.Decimal(12, 3)
  rejectedQty    Decimal                      @default(0) @db.Decimal(12, 3)
  tenantId       String
  lot            StockLot?                    @relation("StockTransferItemLot", fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)
  product        Product                      @relation("TransferProduct", fields: [tenantId, productId], references: [tenantId, id])
  transfer       StockTransfer                @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  receptionItems StockTransferReceptionItem[]

  @@unique([tenantId, id])
  @@index([transferId])
  @@index([productId])
  @@index([lotId])
}

model StockTransferReception {
  id              String                       @id @default(uuid())
  tenantId        String
  transferId      String
  warehouseId     String
  receivedAt      DateTime                     @default(now())
  createdByUserId String?
  reference       String?
  notes           String?
  movement        StockMovement?               @relation("TransferReceptionMovement")
  tenant          Tenant                       @relation(fields: [tenantId], references: [id])
  transfer        StockTransfer                @relation(fields: [tenantId, transferId], references: [tenantId, id])
  warehouse       Warehouse                    @relation("TransferReceptionFrom", fields: [tenantId, warehouseId], references: [tenantId, id])
  items           StockTransferReceptionItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([transferId])
  @@index([warehouseId])
}

model StockTransferReceptionItem {
  id             String                 @id @default(uuid())
  receptionId    String
  transferItemId String
  productId      String
  lotId          String?
  quantity       Decimal                @db.Decimal(12, 3)
  rejectedQty    Decimal                @default(0) @db.Decimal(12, 3)
  tenantId       String
  lot            StockLot?              @relation("StockTransferReceptionItemLot", fields: [tenantId, lotId], references: [tenantId, id], onDelete: SetNull)
  product        Product                @relation("TransferReceptionProduct", fields: [tenantId, productId], references: [tenantId, id])
  reception      StockTransferReception @relation(fields: [tenantId, receptionId], references: [tenantId, id], onDelete: Cascade)
  transferItem   StockTransferItem      @relation(fields: [tenantId, transferItemId], references: [tenantId, id], onDelete: Cascade)

  @@index([receptionId])
  @@index([transferItemId])
}

model StockAdjustment {
  id              String                @id @default(uuid())
  tenantId        String
  warehouseId     String
  reason          String
  reference       String?
  status          AdjustmentStatus      @default(OPEN)
  createdByUserId String?
  closedByUserId  String?
  createdAt       DateTime              @default(now())
  closedAt        DateTime?
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items           StockAdjustmentItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
}

model StockAdjustmentItem {
  id           String                @id @default(uuid())
  adjustmentId String
  productId    String
  stockId      String
  systemQty    Decimal               @db.Decimal(12, 3)
  countedQty   Decimal               @db.Decimal(12, 3)
  difference   Decimal               @db.Decimal(12, 3)
  tenantId     String
  adjustment   StockAdjustment       @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)
  product      Product               @relation(fields: [tenantId, productId], references: [tenantId, id])
  stock        ProductWarehouseStock @relation(fields: [tenantId, stockId], references: [tenantId, id])

  @@index([adjustmentId])
}

model StockReservation {
  id             String                @id @default(uuid())
  tenantId       String
  productId      String
  warehouseId    String
  stockId        String
  quantity       Decimal               @db.Decimal(12, 3)
  orderReference String?
  orderType      String?
  status         ReservationStatus     @default(ACTIVE)
  expiresAt      DateTime?
  releasedAt     DateTime?
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  product        Product               @relation(fields: [tenantId, productId], references: [tenantId, id])
  stock          ProductWarehouseStock @relation(fields: [tenantId, stockId], references: [tenantId, id])
  warehouse      Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  @@index([tenantId])
  @@index([warehouseId])
  @@index([orderReference])
  @@index([expiresAt])
  @@index([status])
}

model StockMovement {
  id                  String                  @id @default(uuid())
  tenantId            String
  productId           String
  type                StockMovementType
  quantity            Decimal                 @db.Decimal(12, 3)
  reason              String?
  reference           String?
  createdByUserId     String?
  createdAt           DateTime                @default(now())
  idempotencyKey      String?
  purchaseReceptionId String?
  quantitySigned      Decimal?                @db.Decimal(12, 3)
  reversalOfId        String?                 @unique
  transferId          String?
  transferReceptionId String?
  warehouseId         String?
  reversalOf          StockMovement?          @relation("MovementReversal", fields: [tenantId, reversalOfId], references: [tenantId, id], onDelete: SetNull, map: "StockMovement_reversalOfId_fkey")
  reversal            StockMovement?          @relation("MovementReversal")
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  product             Product                 @relation(fields: [tenantId, productId], references: [tenantId, id])
  purchaseReception   PurchaseReception?      @relation(fields: [tenantId, purchaseReceptionId], references: [tenantId, id], onDelete: SetNull)
  transfer            StockTransfer?          @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: SetNull)
  transferReception   StockTransferReception? @relation("TransferReceptionMovement", fields: [tenantId, transferReceptionId], references: [tenantId, id], onDelete: SetNull)
  warehouse           Warehouse?              @relation("MovementWarehouse", fields: [tenantId, warehouseId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, transferReceptionId])
  @@unique([tenantId, reversalOfId])
  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([transferId])
  @@index([purchaseReceptionId])
  @@index([transferReceptionId])
  @@index([reversalOfId])
  @@index([createdAt])
}

model AdUnlock {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  status              String    @default("PENDING")
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  grantedAt           DateTime? @map("granted_at") @db.Timestamptz(3)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(3)
  consumedByInvoiceId String?   @map("consumed_by_invoice_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "ad_unlock_tenant_status_idx")
}

model Invoice {
  id                     String          @id @default(uuid())
  tenantId               String
  customerId             String
  number                 String
  type                   String          @default("FT")
  status                 String          @default("ISSUED")
  total                  Decimal         @db.Decimal(12, 2)
  subTotal               Decimal         @db.Decimal(12, 2)
  taxTotal               Decimal         @db.Decimal(12, 2)
  hash                   String?
  previousHash           String?
  signature              String?
  refInvoiceNumber       String?
  cancelReason           String?
  issuedAt               DateTime        @default(now())
  createdAt              DateTime        @default(now())
  discountAmount         Decimal         @default(0) @db.Decimal(12, 2)
  discountType           String          @default("amount")
  discountValue          Decimal         @default(0) @db.Decimal(12, 2)
  applyVat               Boolean         @default(true)
  observations           String?
  includeCompanyProfile  Boolean         @default(false)
  companyProfileSnapshot Json?
  companyLogoId          String?
  dueAt                  DateTime?
  currency               String          @default("AOA")
  sourceDraftId          String?         @unique
  shareExpiresAt         DateTime?
  shareToken             String?         @unique
  lastReminderAt         DateTime?
  emailDeliveries        EmailDelivery[]
  companyLogo            CompanyLogo?    @relation("InvoiceCompanyLogo", fields: [companyLogoId], references: [id], onDelete: Restrict)
  customer               Customer        @relation(fields: [customerId], references: [id])
  sourceDraft            InvoiceDraft?   @relation("DraftConversion", fields: [sourceDraftId], references: [id])
  tenant                 Tenant          @relation(fields: [tenantId], references: [id])
  items                  InvoiceItem[]
  payments               Payment[]
}

model CompanyBankAccount {
  id            String         @id @default(uuid())
  tenantId      String
  bankName      String
  accountHolder String?
  iban          String?
  currency      String         @default("AOA")
  label         String?
  isActive      Boolean        @default(true)
  isPrimary     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceDrafts InvoiceDraft[]

  @@index([tenantId, isActive])
}

model Payment {
  id              String          @id @default(uuid())
  tenantId        String
  invoiceId       String
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("AOA")
  method          String
  status          String          @default("PENDING")
  paymentDate     DateTime
  reference       String?
  notes           String?
  idempotencyKey  String
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User?           @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events          PaymentEvent[]
  receipt         PaymentReceipt?

  @@unique([tenantId, idempotencyKey])
  @@unique([invoiceId, method, reference])
  @@index([tenantId, paymentDate])
  @@index([tenantId, status])
  @@index([invoiceId, status])
}

model InvoiceDraft {
  id                       String              @id @default(uuid())
  tenantId                 String
  customerName             String              @default("")
  customerNif              String?
  items                    Json                @default("[]")
  applyVat                 Boolean             @default(true)
  discountType             String              @default("amount")
  discountValue            Decimal             @default(0) @db.Decimal(12, 2)
  observations             String?
  includeCompanyProfile    Boolean             @default(true)
  currency                 String              @default("AOA")
  dueAt                    DateTime?
  companyBankAccountId     String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  status                   String              @default("DRAFT")
  sourceBusinessDocumentId String?             @unique
  issuedInvoice            Invoice?            @relation("DraftConversion")
  companyBankAccount       CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  sourceBusinessDocument   BusinessDocument?   @relation("BusinessDocumentInvoiceDraft", fields: [sourceBusinessDocumentId], references: [id])
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, updatedAt])
}

model BusinessDocumentCounter {
  tenantId   String
  type       BusinessDocumentType
  year       Int
  lastNumber Int                  @default(0)
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, type, year])
  @@index([tenantId])
}

model BusinessDocument {
  id                    String                  @id @default(uuid())
  tenantId              String
  type                  BusinessDocumentType
  status                BusinessDocumentStatus  @default(DRAFT)
  number                String
  title                 String
  customerId            String?
  createdByUserId       String?
  issueDate             DateTime                @db.Date
  validUntil            DateTime?               @db.Date
  currency              String                  @default("AOA")
  details               String?
  notes                 String?
  subTotal              Decimal                 @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal                 @default(0) @db.Decimal(14, 2)
  total                 Decimal                 @default(0) @db.Decimal(14, 2)
  companySnapshot       Json
  customerSnapshot      Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  createdBy             User?                   @relation("BusinessDocumentCreator", fields: [createdByUserId], references: [id])
  customer              Customer?               @relation(fields: [customerId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events                BusinessDocumentEvent[]
  items                 BusinessDocumentItem[]
  convertedInvoiceDraft InvoiceDraft?           @relation("BusinessDocumentInvoiceDraft")

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, issueDate])
  @@index([customerId, issueDate])
}

model BusinessDocumentItem {
  id                 String           @id @default(uuid())
  tenantId           String
  businessDocumentId String
  productId          String?
  position           Int
  description        String
  quantity           Decimal          @db.Decimal(12, 3)
  unitPrice          Decimal          @db.Decimal(14, 2)
  taxRate            Decimal          @default(0) @db.Decimal(5, 2)
  subTotal           Decimal          @db.Decimal(14, 2)
  taxAmount          Decimal          @db.Decimal(14, 2)
  total              Decimal          @db.Decimal(14, 2)
  businessDocument   BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id])

  @@index([tenantId, businessDocumentId, position])
  @@index([productId])
}

model BusinessDocumentEvent {
  id                 String                    @id @default(uuid())
  tenantId           String
  businessDocumentId String
  actorUserId        String?
  eventType          BusinessDocumentEventType
  previousStatus     BusinessDocumentStatus?
  nextStatus         BusinessDocumentStatus?
  details            Json?
  createdAt          DateTime                  @default(now())
  actorUser          User?                     @relation("BusinessDocumentEventActor", fields: [actorUserId], references: [id])
  businessDocument   BusinessDocument          @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([businessDocumentId, createdAt])
}

model PaymentEvent {
  id             String   @id @default(uuid())
  tenantId       String
  paymentId      String
  eventType      String
  previousStatus String?
  nextStatus     String?
  actorUserId    String?
  snapshot       Json?
  createdAt      DateTime @default(now())
  actorUser      User?    @relation("PaymentEventActor", fields: [actorUserId], references: [id])
  payment        Payment  @relation(fields: [paymentId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([paymentId, createdAt])
}

model CompanyLogo {
  id               String    @id @default(uuid())
  tenantId         String
  mimeType         String
  content          Bytes
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation("TenantLogoVersions", fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[] @relation("InvoiceCompanyLogo")
  currentForTenant Tenant?   @relation("CurrentTenantLogo")

  @@index([tenantId])
}

model User {
  id                        String                  @id @default(uuid())
  name                      String?
  email                     String?                 @unique
  password                  String?
  tenantId                  String?
  createdAt                 DateTime                @default(now())
  platformRole              PlatformRole            @default(NONE)
  tenantRole                TenantRole              @default(USER)
  status                    AccountStatus           @default(ACTIVE)
  suspendedAt               DateTime?
  suspensionReason          String?
  platformPermissions       String[]                @default([])
  emailVerified             DateTime?
  emailVerificationRequired Boolean                 @default(false)
  sessionVersion            Int                     @default(0)
  image                     String?
  accounts                  Account[]
  adminAuditLogs            AdminAuditLog[]         @relation("AdminAuditActor")
  createdBusinessDocuments  BusinessDocument[]      @relation("BusinessDocumentCreator")
  businessDocumentEvents    BusinessDocumentEvent[] @relation("BusinessDocumentEventActor")
  emailActionTokens         EmailActionToken[]
  emailCampaignsCreated     EmailCampaign[]         @relation("EmailCampaignCreator")
  sentEmailDeliveries       EmailDelivery[]         @relation("EmailDeliverySender")
  marketingPreference       MarketingPreference?
  createdPayments           Payment[]               @relation("PaymentCreatedBy")
  paymentEvents             PaymentEvent[]          @relation("PaymentEventActor")
  platformConfigs           PlatformConfig[]        @relation("PlatformConfigUpdatedBy")
  platformInvitesCreated    PlatformTeamInvite[]    @relation("PlatformInviteCreator")
  sessions                  Session[]
  tenant                    Tenant?                 @relation(fields: [tenantId], references: [id])
  jwtRevocations            AuthJwtRevocation[]     @relation("AuthJwtRevocationUser")
  jwtRevocationsActed       AuthJwtRevocation[]     @relation("AuthJwtRevocationActor")
}

model PlatformConfig {
  id                  String   @id @default("global")
  platformName        String   @default("Machine Facturas")
  supportEmail        String?
  supportPhone        String?
  updatedAt           DateTime @default(now()) @updatedAt
  updatedByUserId     String?
  platformDescription String?
  responsibleEntity   String?
  supportWebsite      String?
  adHtml              String?
  updatedBy           User?    @relation("PlatformConfigUpdatedBy", fields: [updatedByUserId], references: [id])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actorType    String   @default("ADMIN")
  action       String
  resourceType String
  resourceId   String?
  reason       String?
  result       String   @default("SUCCESS")
  metadata     Json?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model EmailActionToken {
  id         String             @id @default(uuid())
  userId     String
  purpose    EmailActionPurpose
  tokenHash  String             @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailRequestLimit {
  keyHash         String   @id
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model EmailDelivery {
  id           String              @id @default(uuid())
  purpose      String
  recipient    String
  subject      String
  status       EmailDeliveryStatus
  errorCode    String?
  userId       String?
  tenantId     String?
  invoiceId    String?
  sentByUserId String?
  createdAt    DateTime            @default(now())
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])
  sentBy       User?               @relation("EmailDeliverySender", fields: [sentByUserId], references: [id])
  tenant       Tenant?             @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([invoiceId, createdAt])
  @@index([createdAt])
  @@index([purpose, createdAt])
}

model PlatformTeamInvite {
  id           String           @id @default(uuid())
  name         String
  email        String
  platformRole PlatformRole
  permissions  String[]         @default([])
  tokenHash    String           @unique
  status       TeamInviteStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  createdById  String
  createdBy    User             @relation("PlatformInviteCreator", fields: [createdById], references: [id])

  @@index([email])
  @@index([expiresAt])
}

model MarketingPreference {
  id                   String                   @id @default(uuid())
  userId               String                   @unique
  email                String
  subscribed           Boolean                  @default(false)
  consentAt            DateTime?
  consentSource        String?
  consentVersion       String?
  unsubscribedAt       DateTime?
  unsubscribeTokenHash String?                  @unique
  updatedAt            DateTime                 @updatedAt
  campaignRecipients   EmailCampaignRecipient[]
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscribed, updatedAt])
}

model EmailCampaign {
  id          String                   @id @default(uuid())
  name        String
  subject     String
  htmlContent String
  textContent String
  status      EmailCampaignStatus      @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  createdById String
  createdBy   User                     @relation("EmailCampaignCreator", fields: [createdById], references: [id])
  recipients  EmailCampaignRecipient[]

  @@index([scheduledAt])
}

model EmailCampaignRecipient {
  id            String                       @id @default(uuid())
  campaignId    String
  preferenceId  String
  email         String
  status        EmailCampaignRecipientStatus @default(QUEUED)
  attempts      Int                          @default(0)
  errorCode     String?
  lastAttemptAt DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime                     @default(now())
  campaign      EmailCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  preference    MarketingPreference          @relation(fields: [preferenceId], references: [id])

  @@unique([campaignId, preferenceId])
  @@index([campaignId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model PlatformApplication {
  id                 String              @id @default(uuid())
  slug               String              @unique
  name               String
  description        String?
  icon               String?
  version            String              @default("1.0.0")
  status             ApplicationStatus   @default(ACTIVE)
  isCore             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  planApplications   PlanApplication[]
  tenantApplications TenantApplication[]
}

model SubscriptionPlan {
  id               String               @id @default(uuid())
  slug             String               @unique
  name             String
  description      String?
  priceKz          Decimal              @default(0) @db.Decimal(12, 2)
  billingCycle     String               @default("MONTHLY")
  isBundle         Boolean              @default(false)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  planApplications PlanApplication[]
  subscriptions    TenantSubscription[]
  limits           PlanLimit[]
}

model PlanLimit {
  id     String           @id @default(uuid())
  planId String
  metric String
  value  Int?
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metric])
  @@index([planId])
}

model PlanApplication {
  planId        String
  applicationId String
  application   PlatformApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, applicationId])
}

model TenantApplication {
  id            String              @id @default(uuid())
  tenantId      String
  applicationId String
  enabled       Boolean             @default(false)
  enabledAt     DateTime?
  disabledAt    DateTime?
  config        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   PlatformApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, applicationId])
  @@index([tenantId])
}

model TenantSubscription {
  id        String             @id @default(uuid())
  tenantId  String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuthJwtRevocation {
  id              String   @id @default(uuid())
  jtiHash         String   @unique
  userId          String
  tenantIdAtIssue String?
  reason          String
  revokedAt       DateTime @default(now())
  expiresAt       DateTime
  issuedAt        DateTime?
  actorUserId     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  user            User     @relation("AuthJwtRevocationUser", fields: [userId], references: [id], onDelete: Cascade)
  actorUser       User?    @relation("AuthJwtRevocationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AdjustmentStatus {
  OPEN
  CLOSED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  FULFILLED
}

enum PlatformRole {
  NONE
  ADMIN
  SUPERADMIN
  COMPANY_MANAGER
  USER_MANAGER
  DOCUMENT_MANAGER
  AUDITOR
  SUPPORT
}

enum TenantRole {
  USER
  COMPANY_ADMIN
  BILLING
  VIEWER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EmailActionPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  ACCEPTED
  FAILED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  PAUSED
  COMPLETED
}

enum EmailCampaignRecipientStatus {
  QUEUED
  SENDING
  ACCEPTED
  FAILED
  SUPPRESSED
}

enum BusinessDocumentType {
  PROPOSAL
  QUOTE
  PROFORMA
  PURCHASE_ORDER
  DELIVERY_NOTE
  SERVICE_ORDER
  SERVICE_CONTRACT
  COMPANY_DECLARATION
}

enum BusinessDocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
}

enum BusinessDocumentEventType {
  CREATED
  UPDATED
  ISSUED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED_TO_INVOICE_DRAFT
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
  COMING_SOON
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}
